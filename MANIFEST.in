# setuptools-scm includes every git-tracked file in the sdist by default;
# prune development-only trees so the sdist ships only what a build needs.
prune tests
prune benchmarks
prune docs
prune assets
prune workloads
prune .github
prune .claude
prune .foundry
prune scripts

# Root files a build does not read. setuptools-scm would otherwise ship every
# tracked one; the sdist whitelist in scripts/ci/check_dist_contents.py holds
# this line to its word.
exclude .gitignore
exclude .pre-commit-config.yaml
exclude CLAUDE.md
exclude constraints.txt
